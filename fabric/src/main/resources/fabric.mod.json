{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/grasspow/UniversalClick"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "grasspow.universal_click.fabric.UniversalClickFabricClient"
    ],
    "modmenu": [
      "grasspow.universal_click.fabric.UniversalClickModMenu"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${min_minecraft_version} <${max_minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [
        "Client"
      ],
      "update_checker": true
    }
  }
}
  
